# Ignore everything in this directory by default.
/*

# Keep this ignore file itself.
!/.gitignore

# Keep the top-level files you want to track.
!/README.md
!/main_train.py
!/config.py

# Keep the directories you want to track.
!/dataset/
!/model/
!/train/
!/utils/

# Keep everything inside those directories.
!/dataset/**
!/model/**
!/train/**
!/utils/**

# These top-level paths stay ignored and should not be tracked.
/analyze_mixed_lora_hypothesis.ipynb
/generated_sd15_clip_baseline_artist95/

# Still ignore common Python and Jupyter cache files anywhere.
__pycache__/
*.pyc
.ipynb_checkpoints/
